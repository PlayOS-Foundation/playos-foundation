---
interface Props {
  label?: string;
}
const { label = 'PlayOS screenshots captured on the ROG Ally' } = Astro.props;

const screenshots = [
  { file: 'playos-1741816810.488.png', alt: 'PlayOS running on the ASUS ROG Ally — screenshot 1 of 5' },
  { file: 'playos-1741816817.522.png', alt: 'PlayOS running on the ASUS ROG Ally — screenshot 2 of 5' },
  { file: 'playos-1741816823.283.png', alt: 'PlayOS running on the ASUS ROG Ally — screenshot 3 of 5' },
  { file: 'playos-1741816828.212.png', alt: 'PlayOS running on the ASUS ROG Ally — screenshot 4 of 5' },
  { file: 'playos-1741816834.585.png', alt: 'PlayOS running on the ASUS ROG Ally — screenshot 5 of 5' },
];
---

<div class="pos-carousel" id="screenshot-carousel" role="region" aria-roledescription="carousel" aria-label={label}>
  <div class="pos-carousel-viewport">
    <ul class="pos-carousel-track">
      {screenshots.map((s, i) => (
        <li class="pos-carousel-slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${screenshots.length}`}>
          <img src={`/assets/pos_screenshots/${s.file}`} alt={s.alt} width="1920" height="1080" loading="lazy" />
        </li>
      ))}
    </ul>
    <button class="pos-carousel-btn pos-carousel-prev" type="button" aria-label="Previous screenshot">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
    </button>
    <button class="pos-carousel-btn pos-carousel-next" type="button" aria-label="Next screenshot">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
    </button>
  </div>
  <div class="pos-carousel-dots"></div>
  <p class="pos-carousel-caption">Captured on the ASUS ROG Ally (2023) · 1920 × 1080</p>
</div>

<script>
  const carousel = document.getElementById('screenshot-carousel');
  if (carousel) {
    const track = carousel.querySelector<HTMLElement>('.pos-carousel-track')!;
    const slides = carousel.querySelectorAll('.pos-carousel-slide');
    const dotsWrap = carousel.querySelector<HTMLElement>('.pos-carousel-dots')!;
    const prevBtn = carousel.querySelector<HTMLButtonElement>('.pos-carousel-prev')!;
    const nextBtn = carousel.querySelector<HTMLButtonElement>('.pos-carousel-next')!;
    const count = slides.length;
    let index = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const AUTOPLAY_MS = 5000;
    const reduceMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const dots: HTMLButtonElement[] = [];
    for (let i = 0; i < count; i++) {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'pos-carousel-dot';
      dot.setAttribute('aria-label', `Go to screenshot ${i + 1} of ${count}`);
      dot.addEventListener('click', () => goTo(i, true));
      dotsWrap.appendChild(dot);
      dots.push(dot);
    }

    function goTo(n: number, userInitiated: boolean) {
      index = ((n % count) + count) % count;
      track.style.transform = `translateX(-${index * 100}%)`;
      for (let j = 0; j < count; j++) {
        dots[j].classList.toggle('pos-active', j === index);
        if (j === index) {
          dots[j].setAttribute('aria-current', 'true');
        } else {
          dots[j].removeAttribute('aria-current');
        }
      }
      if (userInitiated) {
        restart();
      }
    }
    function next() {
      goTo(index + 1, true);
    }
    function prev() {
      goTo(index - 1, true);
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }
    function start() {
      if (reduceMotion) {
        return;
      }
      stop();
      timer = setInterval(() => goTo(index + 1, false), AUTOPLAY_MS);
    }
    function restart() {
      start();
    }

    nextBtn.addEventListener('click', next);
    prevBtn.addEventListener('click', prev);
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', start);

    carousel.setAttribute('tabindex', '0');
    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        prev();
        e.preventDefault();
      } else if (e.key === 'ArrowRight') {
        next();
        e.preventDefault();
      }
    });

    let pointerStartX: number | null = null;
    carousel.addEventListener('pointerdown', (e) => {
      pointerStartX = e.clientX;
      stop();
    });
    carousel.addEventListener('pointerup', (e) => {
      if (pointerStartX === null) {
        return;
      }
      const dx = e.clientX - pointerStartX;
      pointerStartX = null;
      if (dx > 40) {
        prev();
      } else if (dx < -40) {
        next();
      } else {
        restart();
      }
    });
    carousel.addEventListener('pointercancel', () => {
      pointerStartX = null;
      restart();
    });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              start();
            } else {
              stop();
            }
          });
        },
        { threshold: 0.25 },
      );
      io.observe(carousel);
    } else {
      start();
    }

    goTo(0, false);
    start();
  }
</script>
